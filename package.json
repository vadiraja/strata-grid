{
  "name": "strata-grid",
  "version": "0.1.0-alpha.0",
  "description": "Open-source React tree data grid with virtualization, lazy hierarchies, and theming for enterprise applications.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vadiraja/strata-grid.git"
  },
  "homepage": "https://github.com/vadiraja/strata-grid#readme",
  "bugs": {
    "url": "https://github.com/vadiraja/strata-grid/issues"
  },
  "keywords": [
    "react",
    "data-grid",
    "tree-grid",
    "table",
    "virtualization",
    "tanstack-table",
    "hierarchy",
    "datatable"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/strata.css",
    "./theme/tokens.css": "./dist/theme/tokens.css",
    "./theme/dark.css": "./dist/theme/dark.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "docs-site"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup && cp src/strata.css dist/strata.css && mkdir -p dist/theme && cp src/theme/*.css dist/theme/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "typedoc && node scripts/add-starlight-frontmatter.mjs && node scripts/write-api-landing.mjs",
    "lint:publish": "publint",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.13.25",
    "lucide-react": "1.16.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^4.8.0",
    "jsdom": "^26.0.0",
    "publint": "^0.3.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
